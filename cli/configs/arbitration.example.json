{
  "project": {
    "name": "example_genearbiter_ordered_gff_run",
    "root": "..",
    "run_id": "ordered_gff_example"
  },
  "strict_input_check": true,
  "gffs": [
    {
      "name": "current",
      "path": "tests/fixtures/tiny_current.gff3"
    },
    {
      "name": "ToolA",
      "path": "tests/fixtures/tiny_tool_a.gff3"
    },
    {
      "name": "ToolB",
      "path": "tests/fixtures/tiny_tool_b.gff3"
    }
  ],
  "evidence": [],
  "params": {
    "candidate_set_mode": "structure_consensus",
    "ai_soft_locus_bp": 50000,
    "ai_hard_locus_bp": 100000
  },
  "api": {
    "profile": "local_rule",
    "run_label": "local_debug",
    "workers": 1,
    "max_attempts": 1,
    "timeout": 180,
    "temperature": 0.0,
    "max_tokens": 2048,
    "api_key_env": ""
  },
  "outputs": {
    "run_dir": "runs/ordered_gff_example_v0_3",
    "strategy": "genearbiter_default"
  },
  "export": {
    "reconcile_ids": true,
    "force_reconcile": true
  },
  "review": {
    "mode": "auto"
  },
  "preprocess": {
    "normalize_gffs": true
  },
  "scoring": {
    "normalization": "run_level"
  }
}
